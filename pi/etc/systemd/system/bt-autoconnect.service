[Unit]
Description=Bluetooth PAN auto-connect to host PC
Documentation=file:///etc/default/bt-autoconnect
Requires=bluetooth.service
After=bluetooth.service systemd-networkd.service
PartOf=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/bt-autoconnect
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
